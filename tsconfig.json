{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["bun"],
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "scripts/**/*.ts"],
  "exclude": ["**/node_modules", "**/results", "**/dist"]
}
