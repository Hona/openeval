{
  "name": "@hona/openeval-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun prepare.ts && bunx --bun --no-install vite --host 127.0.0.1 --port 4176 --strictPort",
    "build": "bun build.ts",
    "verify": "bun verify.ts",
    "test:browser": "playwright test",
    "preview": "bunx --bun --no-install vite preview --host 127.0.0.1 --port 4176 --strictPort",
    "deploy": "wrangler pages deploy dist --project-name openeval --branch main"
  },
  "dependencies": {
    "@hona/openeval": "workspace:*",
    "@opencode/ui": "2.0.3",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "fflate": "0.8.2",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14",
    "wrangler": "4.131.1"
  }
}
